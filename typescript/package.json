{
  "name": "@litebackup/sdk",
  "version": "0.5.0",
  "description": "Back up, replicate, and restore SQLite databases with Litebackup",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "openapi-typescript ../client-openapi.yaml --output src/generated/client.ts",
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepack": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && npm run build"
  },
  "optionalDependencies": {
    "@litebackup/bin-darwin-arm64": "0.5.0",
    "@litebackup/bin-darwin-x64": "0.5.0",
    "@litebackup/bin-linux-arm64": "0.5.0",
    "@litebackup/bin-linux-x64": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
