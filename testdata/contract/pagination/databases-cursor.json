{
  "description": "Database iteration follows next until it is absent.",
  "operation": "databases.iterate",
  "args": {},
  "item_key": "name",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/databases/list",
        "query": {
          "after": "",
          "limit": "100"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "databases": [
            {
              "name": "a.sqlite",
              "path": "/var/lib/app/main.sqlite",
              "role": "origin",
              "state": "syncing",
              "acquired": false,
              "failover": false,
              "local_changed": false,
              "synced_server": {
                "version": 3
              },
              "synced_cloud": {
                "version": 2
              },
              "journal_mode": "wal",
              "page_count": 2,
              "sync_count": 3,
              "hint_misses": 0
            },
            {
              "name": "b.sqlite",
              "path": "/var/lib/app/main.sqlite",
              "role": "origin",
              "state": "syncing",
              "acquired": false,
              "failover": false,
              "local_changed": false,
              "synced_server": {
                "version": 3
              },
              "synced_cloud": {
                "version": 2
              },
              "journal_mode": "wal",
              "page_count": 2,
              "sync_count": 3,
              "hint_misses": 0
            }
          ],
          "next": "b.sqlite"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/v1/databases/list",
        "query": {
