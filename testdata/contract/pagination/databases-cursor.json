        "status": 200,
        "body": {
          "databases": [
            {
              "name": "c.sqlite",
              "path": "/var/lib/app/main.sqlite",
              "role": "origin",
              "state": "syncing",
              "acquired": false,
              "failover": false,
              "local_changed": false,
              "synced_server": {
                "version": 3
              },
              "synced_cloud": {
                "version": 2
              },
              "journal_mode": "wal",
              "page_count": 2,
              "sync_count": 3,
              "hint_misses": 0
            }
          ],
          "next": ""
        }
      }
    }
  ],
  "expect": {
    "items": [
      "a.sqlite",
      "b.sqlite",
      "c.sqlite"
    ]
  }
