{
  "description": "A replica with every setting.",
  "operation": "replicas.start",
  "args": {
    "name": "main.sqlite",
    "to": "reporting.sqlite",
    "write_protection": "detect",
    "timeout": "1500ms"
  },
  "request": {
    "method": "POST",
    "path": "/v1/replicas/start",
    "query": {},
    "body": {
      "name": "main.sqlite",
      "to": "{cwd}/reporting.sqlite",
      "write_protection": "detect",
      "timeout_millis": 1500
    }
  },
  "response": {
    "database": {
      "name": "main.sqlite",
      "path": "/var/lib/app/main.sqlite",
      "role": "replica",
      "state": "syncing",
      "acquired": false,
      "failover": false,
      "local_changed": false,
      "synced_server": {
        "version": 3
      },
      "synced_cloud": {
        "version": 2
      },
      "journal_mode": "wal",
      "page_count": 2,
      "sync_count": 3,
      "hint_misses": 0
    }
  }
}
