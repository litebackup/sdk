{
  "description": "A relative source resolves against the working directory.",
  "operation": "backups.start",
  "args": {
    "source": "data/main.sqlite"
  },
  "request": {
    "method": "POST",
    "path": "/v1/backup-rules/start",
    "query": {},
    "body": {
      "path": "{cwd}/data/main.sqlite"
    }
  },
  "response": {
    "id": "01a1-rule",
    "path": "/var/lib/app/main.sqlite",
    "name": "main.sqlite",
    "prefix": "",
    "watch": "inotify",
    "maximum_local_databases": 0,
    "offload_durability": "server",
    "offload_rollback_journal": false,
    "failover": false
  }
}
