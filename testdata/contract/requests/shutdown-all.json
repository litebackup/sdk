{
  "description": "Shutdown with a durability and a timeout, which could not drain one database.",
  "operation": "session.shutdown",
  "args": {
    "durability": "cloud",
    "timeout": "1m"
  },
  "request": {
    "method": "POST",
    "path": "/v1/session/shutdown",
    "query": {},
    "body": {
      "durability": "cloud",
      "timeout_millis": 60000
    }
  },
  "response": {
    "released_count": 2,
    "failures": [
      {
        "name": "orders.sqlite",
        "code": "lock_unavailable",
        "message": "another machine writes the database (worker-3)"
      }
    ]
  }
}
