{
  "description": "A glob with a prefix, a local database limit, an offload durability of cloud, and consent to offload rollback-journal databases, all of which are sent.",
  "operation": "backups.start",
  "args": {
    "source": "/var/lib/app/tenants/**/*.sqlite",
    "prefix": "tenants/",
    "maximum_local_databases": 10,
    "offload_durability": "cloud",
    "offload_rollback_journal": true
  },
  "request": {
    "method": "POST",
    "path": "/v1/backup-rules/start",
    "query": {},
    "body": {
      "path": "/var/lib/app/tenants/**/*.sqlite",
      "prefix": "tenants/",
      "maximum_local_databases": 10,
      "offload_durability": "cloud",
      "offload_rollback_journal": true
    }
  },
  "response": {
    "id": "01a1-rule",
    "path": "/var/lib/app/main.sqlite",
    "name": "",
    "prefix": "tenants/",
    "watch": "inotify",
    "maximum_local_databases": 0,
    "offload_durability": "cloud",
    "offload_rollback_journal": true,
    "failover": false
  }
}
