{
  "description": "A path object is resolved like a string.",
  "operation": "databases.restore",
  "args": {
    "name": "main.sqlite",
    "to": {
      "$path": "out/restored.sqlite"
    }
  },
  "request": {
    "method": "POST",
    "path": "/v1/databases/restore",
    "query": {},
    "body": {
      "name": "main.sqlite",
      "path": "{cwd}/out/restored.sqlite"
    }
  },
  "response": {
    "name": "main.sqlite",
    "path": "{cwd}/restored.sqlite",
    "version": 3,
    "page_count": 2,
    "page_size": 4096,
    "state_digest": "abc"
  }
}
