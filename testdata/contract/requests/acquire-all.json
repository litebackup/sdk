{
  "description": "Every acquire setting that differs from the default is sent, a lock timeout and a umask other than the process's included.",
  "operation": "databases.acquire",
  "args": {
    "name": "agents/42.sqlite",
    "path": "agents/42.sqlite",
    "maintenance": true,
    "offload_on_release": true,
    "offload_durability": "cloud",
    "machine_label": "worker-1",
    "timeout": "90s",
    "umask": 63,
    "discard_local": true,
    "lock_timeout": "5m"
  },
  "request": {
    "method": "POST",
    "path": "/v1/databases/acquire",
    "query": {},
    "body": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "maintenance": true,
      "offload_on_release": true,
      "offload_durability": "cloud",
      "machine_label": "worker-1",
      "timeout_millis": 90000,
      "umask": 63,
      "discard_local": true,
      "lock_timeout_millis": 300000
    }
  },
  "response": {
    "database": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "role": "origin",
      "state": "syncing",
      "acquired": true,
      "failover": false,
      "local_changed": false,
      "synced_server": {
        "version": 3
      },
      "synced_cloud": {
        "version": 2
      },
      "journal_mode": "wal",
      "page_count": 2,
      "sync_count": 3,
      "hint_misses": 0,
      "offload_durability": "cloud"
    },
    "decision": "created"
  }
}
