{
  "description": "Every acquire setting that differs from the default is sent.",
  "operation": "databases.acquire",
  "args": {
    "name": "agents/42.sqlite",
    "to": "agents/42.sqlite",
    "maintenance": true,
    "offload": "released",
    "machine_label": "worker-1",
    "on_lost": "block",
    "timeout": "90s"
  },
  "request": {
    "method": "POST",
    "path": "/v1/databases/acquire",
    "query": {},
    "body": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "maintenance": true,
      "offload": "released",
      "machine_label": "worker-1",
      "on_lost": "block",
      "timeout_millis": 90000
    }
  },
  "response": {
    "database": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "role": "origin",
      "state": "syncing",
      "acquired": true,
      "failover": false,
      "local_changed": false,
      "synced_server": {
        "version": 3
      },
      "synced_cloud": {
        "version": 2
      },
      "journal_mode": "wal",
      "page_count": 2,
      "sync_count": 3,
      "hint_misses": 0
    },
    "outcome": "created"
  }
}
