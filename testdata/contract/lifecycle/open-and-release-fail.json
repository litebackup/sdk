{
  "description": "A failed open releases at once; when that release fails too, both are raised, open first, and closing the pool tries the release again.",
  "fail": [
    "open",
    "release"
  ],
  "acquire_response": {
    "database": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "role": "origin",
      "state": "syncing",
      "acquired": true,
      "failover": false,
      "local_changed": false,
      "synced_server": {
        "version": 3
      },
      "synced_cloud": {
        "version": 2
      },
      "journal_mode": "wal",
      "page_count": 2,
      "sync_count": 3,
      "hint_misses": 0
    },
    "decision": "created"
  },
  "expect": {
    "steps": [
      "acquire",
      "open",
      "release",
      "release"
    ],
    "acquire_body": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "umask": "{umask}"
    },
    "release_body": {
      "name": "agents/42.sqlite",
      "durability": "cloud",
      "timeout_millis": 600000
    },
    "raised": [
      {
        "source": "open"
      },
      {
        "code": "lease_cleanup_failed",
        "step": "release",
        "cause": "release",
        "details": {
          "step": "release",
          "name": "agents/42.sqlite",
          "path": "{cwd}/agents/42.sqlite",
          "durability": "cloud"
        }
      }
    ],
    "close_raised": [
      {
        "code": "lease_cleanup_failed",
        "step": "release",
        "cause": "release",
        "details": {
          "step": "release",
          "name": "agents/42.sqlite",
          "path": "{cwd}/agents/42.sqlite",
          "durability": "cloud"
        }
      }
    ]
  },
  "lease": {
    "name": "agents/42.sqlite",
    "path": "agents/42.sqlite",
    "durability": "cloud",
    "offload": true
  }
}
