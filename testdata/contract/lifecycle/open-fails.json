{
  "description": "A failed open releases without offload and raises the open error.",
  "scope": {
    "name": "agents/42.sqlite",
    "to": "agents/42.sqlite",
    "durability": "cloud",
    "offload": true
  },
  "fail": [
    "open"
  ],
  "acquire_response": {
    "database": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite",
      "role": "origin",
      "state": "syncing",
      "acquired": true,
      "failover": false,
      "local_changed": false,
      "synced_server": {
        "version": 3
      },
      "synced_cloud": {
        "version": 2
      },
      "journal_mode": "wal",
      "page_count": 2,
      "sync_count": 3,
      "hint_misses": 0
    },
    "outcome": "created"
  },
  "expect": {
    "steps": [
      "acquire",
      "open",
      "release"
    ],
    "acquire_body": {
      "name": "agents/42.sqlite",
      "path": "{cwd}/agents/42.sqlite"
    },
    "release_body": {
      "name": "agents/42.sqlite",
      "wait": "cloud",
      "timeout_millis": 600000
    },
    "raised": [
      {
        "source": "open"
      }
    ]
  }
}
