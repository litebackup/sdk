#!/bin/bash
# Run the Ruby SDK's tests and rubocop in pinned Ruby images, as the calling
# user, with each image's gems cached under ~/.cache/litebackup-ruby.
#
# Usage:
#   scripts/test [--ruby VERSION] [--integration]   tests and rubocop
#   scripts/test [--ruby VERSION] -- COMMAND...      a command in the gem's directory
#   scripts/test generate                            regenerate lib/litebackup/generated/models.rb
#
# --ruby picks one of RUBY_VERSIONS; every one runs by default. --integration
# also runs test/integration_test.rb against LITEBACKUP_PATH, a static
# litebackup binary from scripts/build, mounted at the same path.
set -o errexit
set -o nounset
set -o pipefail

RUBY_VERSIONS=(3.2.11 3.3.14 3.4.13)
GEM_DIRECTORY="$(cd "$(dirname "${0}")/.." && pwd)"
SDK_DIRECTORY="$(dirname "${GEM_DIRECTORY}")"
CACHE_ROOT="${HOME}/.cache/litebackup-ruby"

SELECTED_RUBY_VERSIONS=("${RUBY_VERSIONS[@]}")
INTEGRATION=0
COMMAND=()
while [ "${#}" -gt 0 ]; do
    case "${1}" in
        --ruby)
            if [ "${#}" -lt 2 ]; then
                echo "--ruby needs a version: one of ${RUBY_VERSIONS[*]}" >&2
                exit 2
            fi
            SELECTED_RUBY_VERSIONS=("${2}")
            shift 2
            ;;
        --integration)
            INTEGRATION=1
            shift
            ;;
        generate)
            SELECTED_RUBY_VERSIONS=("${RUBY_VERSIONS[-1]}")
            COMMAND=(ruby scripts/generate)
            shift
            ;;
        --)
            shift
            COMMAND=("${@}")
            break
            ;;
        *)
            echo "unknown argument ${1}" >&2
            exit 2
            ;;
    esac
done

# build_test_image builds the test image of one Ruby version and prints its tag.
build_test_image() {
    local tag="litebackup-ruby-test:${1}"
    docker build --quiet \
        --build-arg "RUBY_IMAGE=ruby:${1}-slim" \
        --tag "${tag}" \
        --file "${GEM_DIRECTORY}/test/Dockerfile" \
        "${GEM_DIRECTORY}/test" >/dev/null
    echo "${tag}"
}

for RUBY_VERSION in "${SELECTED_RUBY_VERSIONS[@]}"; do
    TEST_IMAGE="$(build_test_image "${RUBY_VERSION}")"
    RUBY_CACHE="${CACHE_ROOT}/${RUBY_VERSION}"
    mkdir --parents "${RUBY_CACHE}/bundle" "${RUBY_CACHE}/home"
    DOCKER_MOUNTS=(
        --volume "${SDK_DIRECTORY}:${SDK_DIRECTORY}"
        --volume "${RUBY_CACHE}/bundle:/bundle"
        --volume "${RUBY_CACHE}/home:/tmp/home"
    )
    DOCKER_ENVIRONMENT=(
        --env HOME=/tmp/home
        --env BUNDLE_PATH=/bundle
        --env BUNDLE_APP_CONFIG=/tmp/home/.bundle
    )
    # The RubyGems key a release's gem push uses, passed by name only, so
    # its value never appears in a command line.
    if [ -n "${GEM_HOST_API_KEY:-}" ]; then
        DOCKER_ENVIRONMENT+=(--env GEM_HOST_API_KEY)
    fi
    if [ "${INTEGRATION}" = 1 ]; then
        if [ -z "${LITEBACKUP_PATH:-}" ]; then
            echo "--integration needs LITEBACKUP_PATH, a static litebackup binary from scripts/build" >&2
            exit 2
        fi
        DOCKER_MOUNTS+=(--volume "${LITEBACKUP_PATH}:${LITEBACKUP_PATH}:ro")
        DOCKER_ENVIRONMENT+=(
            --env "LITEBACKUP_PATH=${LITEBACKUP_PATH}"
            --env LITEBACKUP_INTEGRATION=1
        )
    fi
    if [ "${#COMMAND[@]}" -gt 0 ]; then
        CONTAINER_STEPS="bundle install --quiet && \"\${@}\""
    else
        CONTAINER_STEPS="bundle install --quiet && bundle exec rake test && bundle exec rubocop"
    fi
    echo "Ruby ${RUBY_VERSION}"
    # The bundler the lockfile names is installed first, so every image uses it.
    docker run --rm \
        --user "$(id --user):$(id --group)" \
        "${DOCKER_MOUNTS[@]}" \
        "${DOCKER_ENVIRONMENT[@]}" \
        --workdir "${GEM_DIRECTORY}" \
        "${TEST_IMAGE}" \
        bash -c "scripts/install-bundler && ${CONTAINER_STEPS}" \
        litebackup-ruby-test \
        "${COMMAND[@]}"
done
